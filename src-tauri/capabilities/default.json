{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "FirmForge 主窗口的最小权限集合：核心 IPC 与开机自启开关；不含文件系统、shell 与网络插件权限。",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "autostart:default",
    "updater:default",
    "process:allow-restart",
    "core:window:allow-set-theme",
    "dialog:default"
  ]
}