{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FirmForge",
  "version": "1.3.3",
  "identifier": "vip.tatalvpai.firmforge",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5273",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FirmForge",
        "width": 1180,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "tatalvpai",
    "shortDescription": "OpenWrt / ImmortalWrt 固件可视化构建工具",
    "longDescription": "FirmForge 在桌面端选择设备与软件包、配置系统选项，通过 ImageBuilder 容器生成固件，并管理构建历史与产物。",
    "category": "DeveloperTool",
    "resources": [
      "resources/vm/*",
      "resources/qemu/*",
      "resources/qemu/share/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyNTZCOURFMUIxMEI2RUUKUldUdXRoQWIzcmxXWXVRTnBPM0VEUHN2ZTA2dDY3RVR1YllxbFZXTmM1ZXdsQVRZNVBjMkM3VlEK",
      "endpoints": [
        "https://github.com/FirmForge/FirmForge/releases/download/updater/update.json",
        "https://ghproxy.net/https://github.com/FirmForge/FirmForge/releases/download/updater/update-proxy.json"
      ]
    }
  }
}